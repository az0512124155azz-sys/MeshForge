# Never commit real API keys.
# Renderer runtime configuration (Vite exposes only VITE_* variables).
VITE_NVIDIA_API_KEY=
VITE_NVIDIA_MODEL=
VITE_NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

# MeshForge adapter services. These keep vendor-specific APIs outside the UI.
VITE_TRELLIS_API_URL=http://127.0.0.1:8090
VITE_BLENDER_MCP_URL=http://127.0.0.1:9876
